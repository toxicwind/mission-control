#!/usr/bin/env bash
# mission-control — event-driven continuation controller autonomous rig (bin/run).
# Primary operation: run the controller (watches state/missions, classifies
# terminal evidence, emits relaunch directives — no timers, no subagents).
# Usage: bin/run   (blocks while watching state/missions)
set -euo pipefail
cd "$(dirname "$0")/.."

cmd_bun="$(readlink -f "$(command -v bun 2>/dev/null || true)" 2>/dev/null || true)"
for cand in /home/toxic/.bun/bin/bun "$cmd_bun" /usr/local/bin/bun /usr/bin/bun; do
  [ -x "$cand" ] && { REAL_BUN="$cand"; break; }
done
[ -n "${REAL_BUN:-}" ] || { echo "FAIL: bun not found"; exit 1; }

echo "== mission-control run: starting controller (watching state/missions) =="
exec "$REAL_BUN" run src/controller.ts